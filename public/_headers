/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.googletagmanager.com https://www.google-analytics.com 'unsafe-inline'; connect-src 'self' https://api.web3forms.com https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/*
  Cache-Control: no-store, no-cache, must-revalidate

/*.html
  Cache-Control: no-store, no-cache, must-revalidate

/*.js
  Cache-Control: no-store, no-cache, must-revalidate

/*.css
  Cache-Control: no-store, no-cache, must-revalidate

/assets/*
  Cache-Control: no-store, no-cache, must-revalidate

/assets/*.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
